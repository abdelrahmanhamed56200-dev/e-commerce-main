    "@angular/compiler-cli": "^21.2.0",
    "@schematics/angular": "^21.2.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-tailwindcss"
