    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.3",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@netlify/angular-runtime": "^3.0.1",
    "@rxweb/reactive-form-validators": "^13.0.1",
    "@sweetalert2/ngx-sweetalert2": "^14.1.4",
    "express": "^5.1.0",
    "flowbite": "^4.0.1",
    "ngx-pagination": "^6.0.3",
    "ngx-toastr": "^20.0.5",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.24",
    "swiper": "^12.1.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.3",
